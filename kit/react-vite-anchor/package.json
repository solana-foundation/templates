{
  "name": "react-vite-anchor",
  "description": "React + Vite, Tailwind, Kit 8 wallet integration, Anchor vault program",
  "keywords": [
    "anchor",
    "kit",
    "react",
    "solana-kit",
    "tailwind",
    "typescript",
    "vite"
  ],
  "create-solana-dapp": {
    "rename": {
      "scaffold": {
        "to": "{{name}}",
        "paths": [
          "src"
        ]
      }
    }
  },
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "anchor-build": "cd anchor && anchor build --ignore-keys",
    "anchor-test": "cd anchor && anchor build --ignore-keys && cargo test",
    "build": "tsc -b && vite build",
    "ci": "npm run build && npm run lint && npm run format:check && npm run test",
    "test": "vitest run",
    "codama:js": "codama run js",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup": "npm run anchor-build && npm run codama:js"
  },
  "dependencies": {
    "@solana/kit": "^8.3.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.20.0",
    "@solana/react": "^8.2.0",
    "@wallet-standard/ui-registry": "^1.0.1",
    "@tailwindcss/vite": "^4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/wallet": "^1.1.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.7",
    "@codama/nodes-from-anchor": "1.5.3",
    "@codama/renderers-js": "1.7.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.3",
    "codama": "1.10.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6"
  }
}
