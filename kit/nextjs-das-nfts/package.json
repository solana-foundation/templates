{
  "name": "nextjs-das-nfts",
  "displayName": "DAS NFT Viewer",
  "description": "Next.js, Tailwind, @solana/kit — a custom RPC and plugin for the Metaplex DAS API, with an NFT viewer built on it",
  "usecase": "Starter",
  "keywords": [
    "kit",
    "nextjs",
    "react",
    "solana-kit",
    "das",
    "digital-asset-standard",
    "nft",
    "compressed-nft",
    "metaplex",
    "custom-rpc",
    "plugin",
    "tailwind",
    "typescript"
  ],
  "create-solana-dapp": {
    "rename": {
      "scaffold": {
        "to": "{{name}}",
        "paths": [
          "app"
        ]
      }
    }
  },
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "next start"
  },
  "dependencies": {
    "@solana/kit": "^7.0.0",
    "@solana/kit-plugin-rpc": "^0.15.0",
    "@solana/kit-plugin-wallet": "^0.14.0",
    "@solana/react": "^7.0.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swr": "^2.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
