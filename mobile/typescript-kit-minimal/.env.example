# RPC endpoint for Devnet.
#
# The public endpoint is the default and works with no configuration. Point this at your own
# provider if you hit its rate limits.
VITE_RPC_URL_DEVNET=

# Mobile Wallet Adapter reflector host, used for the desktop-to-phone QR code flow.
# Leave this empty to offer Mobile Wallet Adapter only in Chrome on Android, where it connects to a
# wallet installed on the same device and needs no reflector.
VITE_MWA_REMOTE_HOST_AUTHORITY=
