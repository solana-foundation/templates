{
  "name": "expo-kit-minimal",
  "displayName": "Expo Kit Minimal example",
  "description": "A minimal template for building a Solana mobile app with Expo, React Native, and Solana Kit.",
  "usecase": "Mobile",
  "keywords": [
    "expo",
    "mobile-wallet-adapter",
    "react-native",
    "solana-kit"
  ],
  "create-solana-dapp": {
    "options": {
      "keep-example": {
        "default": true,
        "description": "Keep the example account and network screens",
        "group": "example",
        "instructions": [
          "Verify your Android development environment:",
          "+npx -y solana-mobile@latest doctor",
          "Build the Android app locally:",
          "+{pm} run android",
          "Remove the example code and start from a blank app:",
          "+{pm} run reset-project"
        ]
      },
      "reset-project": {
        "description": "Start from a blank app instead of the example code",
        "group": "example",
        "instructions": [
          "Verify your Android development environment:",
          "+npx -y solana-mobile@latest doctor",
          "Build the Android app locally:",
          "+{pm} run android",
          "Edit app/index.tsx to build your first screen.",
          "Reach for the wallet with useSeekerWallet() from @/components/seeker-wallet-provider."
        ],
        "run": "reset-project -- --yes"
      }
    },
    "skills": [
      "https://github.com/solana-foundation/solana-dev-skill",
      "https://github.com/solana-mobile/solana-mobile-dev-skill"
    ],
    "versions": {
      "adb": "33.0.0"
    }
  },
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run test && npm run android:build",
    "dev": "expo start --clear --dev-client --reset-cache",
    "doctor": "npx -y expo-doctor@latest",
    "e2e": "./e2e/fakewallet.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "reset-project": "node ./scripts/reset-project.js",
    "start": "expo start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@solana-mobile/seeker-connect-react-native": "^0.2.0",
    "@solana-program/memo": "^0.15.0",
    "@solana/kit": "^8.4.0",
    "@tanstack/react-query": "^5.90.7",
    "@wallet-ui/react-native-kit": "^4.4.1",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.7",
    "js-base64": "^3.7.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "~0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.5",
    "vitest": "^5.0.2",
    "vitest-native": "^0.9.0"
  },
  "private": true
}
