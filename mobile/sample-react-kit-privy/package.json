{
  "name": "sample-react-kit-privy",
  "displayName": "React Kit Privy sample",
  "description": "A sample Solana web app with React, Privy auth, Solana Kit, and Mobile Wallet Adapter.",
  "usecase": "Mobile",
  "keywords": [
    "mobile-wallet-adapter",
    "privy",
    "react",
    "sample",
    "shadcn",
    "solana-kit",
    "tailwind",
    "vite",
    "wallet"
  ],
  "create-solana-dapp": {
    "instructions": [
      "Set up your Privy app:",
      "+1. Log in or sign up at https://dashboard.privy.io",
      "+2. Open https://dashboard.privy.io/organization-overview and click New app",
      "+3. Enter your app name, select Web app, and click Create app",
      "+4. Save the App ID, then click Close",
      "+5. Go to User management > Authentication",
      "+6. In the External wallets card, enable SVM (Solana) wallets",
      "+7. Go to App settings > Clients",
      "+8. Save the Client ID for the default web app client",
      "",
      "Configure your environment:",
      "+cp .env.example .env",
      "VITE_PRIVY_APP_ID=your-privy-app-id",
      "VITE_PRIVY_CLIENT_ID=your-privy-client-id",
      "",
      "Do not put the Privy app secret in .env; this web app only uses public client-side Privy identifiers.",
      "",
      "Accept the terms for the Solana Mobile relay this app uses:",
      "+https://docs.solanamobile.com/solana-mobile-stack/seeker-connect-quickstart",
      "",
      "Start the development server:",
      "+{pm} run dev"
    ],
    "rename": {
      "React Kit Privy": {
        "paths": [
          "."
        ],
        "to": "{{name}}"
      }
    },
    "skills": [
      "https://github.com/solana-foundation/solana-dev-skill",
      "https://github.com/solana-mobile/solana-mobile-dev-skill"
    ]
  },
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -b && vite build",
    "ci": "npm run lint:check && npm run format:check && npm run build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.38.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@solana-mobile/seeker-connect-ui": "^0.1.2",
    "@solana-mobile/seeker-connect-wallet-standard": "^0.1.2",
    "@solana-mobile/wallet-standard-mobile": "^0.7.0",
    "@solana-program/memo": "^0.13.0",
    "@solana-program/system": "^0.14.0",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.4.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.21.0",
    "@solana/react": "^8.4.0",
    "@solana/wallet-standard-chains": "^1.1.2",
    "@solana/wallet-standard-util": "^1.1.3",
    "@stripe/stripe-js": "^1.54.2",
    "@tanstack/react-query": "^5.102.6",
    "@wallet-standard/react": "^1.0.3",
    "@wallet-standard/ui": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "private": true
}
