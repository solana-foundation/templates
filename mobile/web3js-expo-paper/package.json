{
  "name": "web3js-expo-paper",
  "displayName": "Paper Boilerplate",
  "description": "A template for building a Solana mobile app with Expo and React Native Paper.",
  "usecase": "Mobile",
  "keywords": [
    "expo",
    "mobile-wallet-adapter",
    "react-native",
    "react-native-paper",
    "solana-web3js"
  ],
  "create-solana-dapp": {
    "instructions": [
      "To buld the Android app locally, run this:",
      "+{pm} run android"
    ],
    "versions:": {
      "adb": "33.0.0"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-snackbar"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run android:build",
    "dev": "expo start",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "reset-project": "node ./scripts/reset-project.js",
    "start": "expo start",
    "web": "expo start --web"
  },
  "main": "./index.js",
  "version": "1.0.0",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.85.5",
    "@wallet-ui/react-native-web3js": "^4.0.1",
    "deepmerge": "^4.3.1",
    "expo": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "js-base64": "^3.7.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.14.5",
    "react-native-quick-crypto": "^1.0.6",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-qr-code": "^2.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.33.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
