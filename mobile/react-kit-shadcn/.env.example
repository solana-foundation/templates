# RPC endpoints.
#
# Devnet, Testnet, and Localnet all have defaults, so the network picker works with no
# configuration. Localnet defaults to http://localhost:8899 — set this only if your validator
# listens somewhere else.
#
# Mainnet is the exception: it stays hidden from the picker until you name an endpoint here. The
# public mainnet endpoint is rate limited and serves no websocket, so account subscriptions fail
# against it and there is no usable default to fall back on.
VITE_RPC_URL_DEVNET=
VITE_RPC_URL_LOCALNET=
VITE_RPC_URL_MAINNET=
VITE_RPC_URL_TESTNET=

# Mobile Wallet Adapter reflector host, used for the desktop-to-phone QR code flow.
# Leave this empty to offer Mobile Wallet Adapter only in Chrome on Android, where it connects to a
# wallet installed on the same device and needs no reflector.
VITE_MWA_REMOTE_HOST_AUTHORITY=
