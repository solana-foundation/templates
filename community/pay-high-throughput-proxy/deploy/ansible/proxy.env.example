# Copy to proxy.env with `just setup`, then fill in all four values.
# This file is ignored by git and installed to the proxy with mode 0640.
# Devnet only. Do not put mainnet keys or real funds here.

# A devnet Solana RPC URL (e.g. a Helius or public devnet endpoint).
PAY_RPC_URL=

# A devnet public key that receives settled payments.
PAY_PAYMENT_RECIPIENT=

# Operator keypair that pays channel-open / settlement fees (the paywall sets
# fee_payer: true). JSON byte array or base58, e.g. the contents of a
# `solana-keygen new` keyfile. Fund it with devnet SOL before deploying.
PAY_OPERATOR_KEYPAIR=

# Stable random hex secret that binds session challenges. Keep it constant so
# session tokens survive a service restart, e.g. `openssl rand -hex 32`.
PAY_SESSION_SECRET=
