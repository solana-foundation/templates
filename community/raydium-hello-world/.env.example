# All values are optional — the template runs with zero configuration.
# NEXT_PUBLIC_* values are compiled into the browser bundle: never put
# secrets in them.

# Custom RPC endpoint (devnet). Defaults to clusterApiUrl("devnet").
# e.g. https://devnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_RPC_ENDPOINT=

# CPMM pool to swap against. Defaults to the deepest devnet pool.
# Find live devnet pools (docs: https://docs.raydium.io/sdk-api/rest-api):
#   curl "https://api-v3-devnet.raydium.io/pools/info/list?poolType=standard&poolSortField=default&sortType=desc&pageSize=3&page=1"
NEXT_PUBLIC_POOL_ID=

# Input mint. Defaults to wrapped SOL (So11111111111111111111111111111111111111112).
NEXT_PUBLIC_INPUT_MINT=

# Optional default for the amount input, in raw units of the input mint
# (e.g. 10000000 = 0.01 SOL). Leave empty for a blank input.
NEXT_PUBLIC_AMOUNT_RAW=
