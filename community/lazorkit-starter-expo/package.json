{
  "name": "lazorkit-starter-expo",
  "displayName": "LazorKit Starter (Expo)",
  "description": "React Native (Expo) template with LazorKit passkey wallet integration for Solana",
  "usecase": "Mobile",
  "keywords": [
    "solana",
    "lazorkit",
    "passkey",
    "smart-wallet",
    "expo",
    "react-native",
    "mobile",
    "typescript"
  ],
  "create-solana-dapp": {
    "instructions": [
      "Install dependencies:",
      "+{pm} install",
      "Start the Expo development server:",
      "+{pm} start"
    ]
  },
  "main": "expo-router/entry",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@lazorkit/wallet-mobile-adapter": "^2.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@solana/web3.js": "^1.99.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "js-sha256": "^0.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@lazorkit/wallet-mobile-adapter": {
      "expo-crypto": "$expo-crypto",
      "expo-web-browser": "$expo-web-browser"
    }
  },
  "pnpm": {
    "overrides": {
      "@lazorkit/wallet-mobile-adapter>expo-crypto": "~58.0.7",
      "@lazorkit/wallet-mobile-adapter>expo-web-browser": "~58.0.6"
    }
  }
}
