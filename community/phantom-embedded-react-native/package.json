{
  "name": "phantom-embedded-react-native-starter",
  "version": "1.0.0",
  "description": "Expo starter for Phantom's embedded wallet on Solana. Google or Apple OAuth, no extension needed.",
  "displayName": "Phantom Embedded React Native Starter",
  "usecase": "Mobile",
  "keywords": [
    "solana",
    "phantom",
    "wallet",
    "embedded-wallet",
    "react-native",
    "expo",
    "mobile",
    "typescript",
    "oauth",
    "authentication"
  ],
  "author": "Phantom",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phantom/phantom-embedded-react-native-starter"
  },
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "test": "node --test tests/auth-routing.test.cjs"
  },
  "create-solana-dapp": {
    "instructions": [
      "Your Phantom Embedded React Native starter is ready!",
      "",
      "Next steps:",
      "+1. Confirm access to a Phantom Portal App ID: https://phantom.com/portal",
      "+2. Copy .env.example to .env and add your App ID",
      "+3. Match EXPO_PUBLIC_APP_SCHEME to app.json and allowlist the full callback URL in Phantom Portal",
      "+4. Follow README.md to configure your native app identifiers and development build",
      "",
      "Start developing:",
      "+{pm} start",
      "",
      "Important: This template requires a development build and will not work with Expo Go.",
      "+{pm} run android  # or {pm} run ios",
      "",
      "Learn more:",
      "- React Native SDK Docs: https://docs.phantom.com/sdks/react-native-sdk",
      "- Expo Development Builds: https://docs.expo.dev/develop/development-builds/introduction/",
      "- Get Support: https://discord.gg/phantom"
    ],
    "rename": {
      "phantom-embedded-react-native-starter": {
        "to": "{{name}}",
        "paths": [
          "app",
          "components",
          "lib",
          "package.json",
          "README.md",
          "app.json"
        ]
      }
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo/vector-icons": "^15.0.3",
    "@phantom/react-native-sdk": "^2.0.2",
    "@solana/web3.js": "^1.95.0",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.8",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/node": "^24.10.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.20.0"
}
