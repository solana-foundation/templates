# Phantom App Configuration
# Get your App ID from https://phantom.com/portal/

# Your Phantom App ID (Required)
EXPO_PUBLIC_PHANTOM_APP_ID=your-app-id-here

# App URL scheme (Required)
# Used to build the OAuth callback: {scheme}://phantom-auth-callback
# Must match the "scheme" in app.json. Allowlist the complete callback URL
# in Phantom Portal under URL Config.
EXPO_PUBLIC_APP_SCHEME=phantomwallet

# Solana RPC Endpoint (Optional)
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
