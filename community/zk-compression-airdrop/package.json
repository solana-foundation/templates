{
  "name": "zk-compression-airdrop",
  "displayName": "ZK Compression Airdrop",
  "usecase": "Airdrop",
  "scripts": {
    "build": "next build",
    "ci": "npm run build && npm run lint && npm run format:check && npm test",
    "test": "vitest run",
    "dev": "next dev --turbopack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "next start",
    "airdrop:setup": "npm run airdrop:wallets && npm run airdrop:mint && npm run airdrop:recipients",
    "airdrop:wallets": "tsx scripts/generate-test-wallets.ts",
    "airdrop:mint": "tsx scripts/create-compressed-mint.ts",
    "airdrop:recipients": "tsx scripts/generate-recipients.ts"
  },
  "description": "Wallet-approved ZK compressed token airdrops with Kit 8 and V1 transactions",
  "keywords": [
    "minimal",
    "nextjs",
    "react",
    "solana-kit",
    "tailwind",
    "typescript",
    "zk-compression",
    "airdrop",
    "zero-knowledge",
    "zk"
  ],
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@lightprotocol/compressed-token": "^0.22.0",
    "@lightprotocol/stateless.js": "^0.22.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@solana/kit": "^8.3.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.20.0",
    "@solana/react": "^8.2.0",
    "@wallet-standard/ui-registry": "^1.0.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "jotai": "^2.14.0",
    "js-sha3": "^0.9.3",
    "lucide-react": "^0.544.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "@wallet-standard/app": "^1.1.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.7",
    "tsx": "^4.19.2",
    "@coral-xyz/anchor": "^0.31.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bn.js": "^5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.0.10",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "ws": "^8.18.3"
