{
  "name": "x402-template",
  "version": "0.1.0",
  "private": true,
  "displayName": "x402 Next.js",
  "description": "Next.js Solana starter with x402 payment protocol integration",
  "usecase": "Payments",
  "keywords": [
    "solana",
    "nextjs",
    "x402",
    "template",
    "starter"
  ],
  "create-solana-dapp": {
    "instructions": [
      "Install dependencies:",
      "+{pm} install",
      "Copy the environment file and set NEXT_PUBLIC_RECEIVER_ADDRESS to your Solana address:",
      "+cp .env.example .env.local",
      "Start dev server:",
      "+{pm} dev"
    ],
    "rename": {
      "project-name": {
        "to": "{{name}}",
        "paths": [
          "README.md",
          "src"
        ]
      }
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@x402/core": "^2.27.0",
    "@x402/next": "^2.27.0",
    "@x402/paywall": "^2.27.0",
    "@x402/svm": "^2.27.0",
    "next": "16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
