# x402 Configuration
# Copy this file to .env.local and fill in your values

# Your Solana wallet address that will receive payments (required)
# This is where all payments will be sent
NEXT_PUBLIC_RECEIVER_ADDRESS=CmGgLQL36Y9ubtTsy2zmE46TAxwCBm66onZmPPhUWNqv

# Solana network to use, as a CAIP-2 id (x402 v2)
# Options: solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1 (devnet), solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp (mainnet)
# Use devnet for testing with fake tokens, mainnet for production with real money
NEXT_PUBLIC_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1

# Facilitator URL
# The service that verifies and settles payments on the blockchain
# Default: https://x402.org/facilitator (testnet only, does not support solana mainnet)
# For mainnet, use a facilitator that supports Solana mainnet, for example
# PayAI facilitator (no API key needed to get started: https://docs.payai.network/x402/servers/introduction) or the
# Coinbase CDP facilitator (requires CDP API keys: https://docs.cdp.coinbase.com/x402/seller/quickstart)
# More options: https://docs.x402.org/dev-tools/facilitators
NEXT_PUBLIC_FACILITATOR_URL=https://x402.org/facilitator
