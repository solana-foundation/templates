# MoneyGram Ramps — sandbox credentials (server-side only)
# Copy this file to .env.local and fill in the values from your MoneyGram onboarding.

# Sandbox secret key — NEVER exposed to the browser. Used by app/api/moneygram-session.
MONEYGRAM_SK=ramps_sk_sbox_...

# Sandbox sessions endpoint (default shown; override if MoneyGram gives you another).
MONEYGRAM_SESSIONS_URL=https://playground.xramps.moneygram.com/api/v1/sessions

# Widget / SDK origin (client-safe). Only change if MoneyGram gives you a different host.
NEXT_PUBLIC_RAMPS_ORIGIN=https://playground.xramps.moneygram.com
