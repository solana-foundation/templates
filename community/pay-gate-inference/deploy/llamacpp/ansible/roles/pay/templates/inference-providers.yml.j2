# Override Pay.sh's built-in llama.cpp provider because this deployment keeps
# llama-server on private port {{ llamacpp_port }} and exposes the gateway on
# port {{ pay_gateway_port }}.
providers:
  - slug: llama-cpp
    title: llama.cpp
    ports: [{{ llamacpp_port }}]
    color: "#f59e0b"
    identify:
      - path: /props
        expect_json_key: default_generation_settings
    models:
      path: /v1/models
      json_pointer: /data
      name_key: id
    paid:
      - { method: POST, path: v1/responses }
      - { method: POST, path: v1/chat/completions }
      - { method: POST, path: v1/completions }
      - { method: POST, path: v1/embeddings }
      - { method: POST, path: completion }
      - { method: POST, path: infill }
      - { method: POST, path: embedding }
