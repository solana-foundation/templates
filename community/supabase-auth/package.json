{
  "name": "supabase-auth",
  "scripts": {
    "build": "next build",
    "ci": "npm run build && npm run lint && npm run format:check && npm test",
    "test": "vitest run",
    "dev": "next dev --turbopack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "next start"
  },
  "displayName": "Supabase Auth",
  "description": "Authenticate Solana wallets with Supabase",
  "usecase": "Auth",
  "keywords": [
    "supabase",
    "authentication",
    "solana",
    "solana-kit"
  ],
  "create-solana-dapp": {
    "instructions": [
      "Set up Supabase:",
      "1. Create a project at https://supabase.com",
      "2. Copy .env.example to .env.local and add your Supabase credentials",
      "3. Enable Solana Web3 authentication in your Supabase project",
      "Start the app: +{pm} run dev"
    ]
  },
  "version": "0.0.0",
  "private": true,
  "prettier": {
    "singleQuote": true,
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@solana-program/system": "^0.15.0",
    "@solana/kit": "^8.3.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.20.0",
    "@solana/react": "^8.2.0",
    "@solana/wallet-standard-util": "^1.2.0",
    "@wallet-standard/ui-registry": "^1.0.1",
    "@supabase/supabase-js": "^2.76.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.14.0",
    "lucide-react": "^0.544.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@wallet-standard/app": "^1.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.7",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.0.10",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "ws": "^8.18.3"
  }
}
