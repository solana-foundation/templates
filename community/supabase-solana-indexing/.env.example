# Public values used by the Next.js dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_PROGRAM_ID=YOUR_PROGRAM_ID

# Server-only value. Never expose this key in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Use an RPC provider that supports getProgramAccounts and WebSocket subscriptions.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
INDEXER_COMMITMENT=confirmed
INDEXER_BATCH_SIZE=250
# Periodically reopen the subscription and reconcile accounts that closed or changed owner.
INDEXER_RECONCILE_INTERVAL_MS=300000

# Optional timeout for the end-to-end live integration test.
LIVE_TEST_TIMEOUT_MS=90000
# Require a post-backfill Solana account update to reach Supabase during the test.
LIVE_TEST_REQUIRE_SOLANA_UPDATE=false
