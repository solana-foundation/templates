# Secret used to sign the Sign In With Solana session cookie (HMAC-SHA256).
# Required for sign-in; must be at least 32 characters. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Public origin users sign in from, e.g. https://app.example.com. Sign In With
# Solana messages must be signed for this host. Required in production; in
# development the request's Host header is used when this is empty.
APP_URL=

# Optional. The public mainnet endpoint rejects most browser traffic, so set
# this to your RPC provider's mainnet URL before using the mainnet cluster.
NEXT_PUBLIC_MAINNET_RPC_URL=
